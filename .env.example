#====================================
#.env file template
#====================================
#1. Put your phone number in the OWNERS variable(with your country code). If multiple owners exist, add a comma between them (e.g., 961056436,96103642579). Make sure to include your country code as well
#2. Get your Gemini API key and summary API Key(they can be the same key) from https://aistudio.google.com/api-keys (if you want to enable AI features)
#3. Get your remove.bg API key from https://www.remove.bg/api (if you want to enable the remove.bg feature)

OWNERS=
GEMINI_API_KEY=
SUMMARY_API_KEY=
REMOVE_BG_API_KEY=
